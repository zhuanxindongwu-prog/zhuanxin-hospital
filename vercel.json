{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "zhuanxin-hospital.vercel.app"
        }
      ],
      "destination": "https://cardiospecialvh.tw/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/adminLogin",
      "destination": "/index.html"
    },
    {
      "source": "/adminAppointments",
      "destination": "/index.html"
    },
    {
      "source": "/doctor-schedule",
      "destination": "/index.html"
    },
    {
      "source": "/pet-cpr-game",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/imgs/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
