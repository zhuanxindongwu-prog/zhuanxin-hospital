{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/post-article",
      "destination": "/articles/dog-mmvd-treatment-options",
      "permanent": true
    },
    {
      "source": "/post-article-2",
      "destination": "/articles/still-beating-veterinary-cardiology",
      "permanent": true
    },
    {
      "source": "/post-article-3",
      "destination": "/articles/pet-heart-disease-warning-signs",
      "permanent": true
    },
    {
      "source": "/post-mmvd-stage-c",
      "destination": "/articles/dog-mmvd-stage-c-care",
      "permanent": true
    },
    {
      "source": "/heart-pressure",
      "destination": "/articles/pet-heart-disease-screening",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "zhuanxin-hospital.vercel.app"
        }
      ],
      "destination": "https://cardiospecialvh.tw/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "zhuanxin-hospital.vercel.app"
        }
      ],
      "destination": "https://cardiospecialvh.tw/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/adminLogin",
      "destination": "/index.html"
    },
    {
      "source": "/adminAppointments",
      "destination": "/index.html"
    },
    {
      "source": "/doctor-schedule",
      "destination": "/index.html"
    },
    {
      "source": "/pet-cpr-game",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/adminLogin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/adminAppointments",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/doctor-schedule",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/pet-cpr-game",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/imgs/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
