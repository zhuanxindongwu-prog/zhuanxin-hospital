{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/post-article",
      "destination": "/articles/dog-mmvd-treatment-options",
      "permanent": true
    },
    {
      "source": "/post-article-2",
      "destination": "/articles/still-beating-veterinary-cardiology",
      "permanent": true
    },
    {
      "source": "/post-article-3",
      "destination": "/articles/pet-heart-disease-warning-signs",
      "permanent": true
    },
    {
      "source": "/post-mmvd-stage-c",
      "destination": "/articles/dog-mmvd-stage-c-care",
      "permanent": true
    },
    {
      "source": "/heart-pressure",
      "destination": "/articles/pet-heart-disease-screening",
      "permanent": true
    },
    {
      "source": "/二尖瓣退化",
      "destination": "/topics/mmvd",
      "permanent": true
    },
    {
      "source": "/常見心律不整",
      "destination": "/services/veterinary-cardiology",
      "permanent": true
    },
    {
      "source": "/先天性心臟病",
      "destination": "/articles/congenital-heart-disease-preoperative-screening",
      "permanent": true
    },
    {
      "source": "/擴張性心肌病",
      "destination": "/services/veterinary-cardiology",
      "permanent": true
    },
    {
      "source": "/x光",
      "destination": "/services/veterinary-cardiology",
      "permanent": true
    },
    {
      "source": "/血液檢查",
      "destination": "/services/veterinary-cardiology",
      "permanent": true
    },
    {
      "source": "/在家監控呼吸心跳",
      "destination": "/petvoice-guide",
      "permanent": true
    },
    {
      "source": "/衛教資訊",
      "destination": "/articles",
      "permanent": true
    },
    {
      "source": "/articles/media/dog-mmvd-nonlinear-progression-chordal-rupture",
      "destination": "/articles/dog-mmvd-nonlinear-progression-chordal-rupture",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "zhuanxin-hospital.vercel.app"
        }
      ],
      "destination": "https://cardiospecialvh.tw/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "zhuanxin-hospital.vercel.app"
        }
      ],
      "destination": "https://cardiospecialvh.tw/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/adminLogin",
      "destination": "/"
    },
    {
      "source": "/adminAppointments",
      "destination": "/"
    },
    {
      "source": "/doctor-schedule",
      "destination": "/"
    },
    {
      "source": "/pet-cpr-game",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/adminLogin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/adminAppointments",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/doctor-schedule",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/pet-cpr-game",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/imgs/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
