{
  "name": "zhuanxin-hospital",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-static-seo.mjs && node scripts/prune-dist-assets.mjs",
    "preview": "vite preview",
    "test": "node --test src/*.test.js src/router/*.test.js",
    "test:seo": "npm run build && node --test scripts/seo-phases-1-3.test.js",
    "seo:audit": "node scripts/seo-audit.mjs",
    "verify": "npm run test:seo && npm test && npm run seo:audit"
  },
  "dependencies": {
    "@vueuse/head": "^2.0.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "firebase": "^12.13.0",
    "vue": "^3.5.32",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/compiler-dom": "3.5.32",
    "@vue/compiler-sfc": "3.5.32",
    "vite": "^8.0.4"
  }
}
